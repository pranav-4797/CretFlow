# ─── Firebase Admin & Cloud Firestore ─────────────────────────────────────────
FIREBASE_PROJECT_ID=your-firebase-project-id
# Path to service account JSON file (recommended for local dev):
FIREBASE_CREDENTIALS_PATH=serviceAccountKey.json
# Alternatively, provide client email and private key directly (e.g. for Render/cloud deployment):
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n"

# ─── Google OAuth & Gmail Integration ─────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CLIENT_SECRETS_PATH=client_secret.json
# For local dev: http://localhost:8000/api/google/oauth/callback
# For production Render: https://certflow.onrender.com/api/google/oauth/callback
GOOGLE_REDIRECT_URI=https://certflow.onrender.com/api/google/oauth/callback
GMAIL_SCOPES=https://www.googleapis.com/auth/gmail.send
# 32-byte url-safe base64 key for encrypting OAuth refresh tokens at rest in Firestore
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# ─── Certificate Storage (Shared Drive / Google Drive) ────────────────────────
STORAGE_PROVIDER=shared_drive
GOOGLE_DRIVE_SHARED_DRIVE_NAME=CertFlow
GOOGLE_DRIVE_SHARED_DRIVE_ID=0ADWQx7sZb558Uk9PVA
GOOGLE_DRIVE_CAMPAIGNS_FOLDER_ID=1GvgzDjRxRsK92PiD7qNqCUlEttxv_TVq
GOOGLE_DRIVE_REPORTS_FOLDER_ID=1kBGhirabX-vZI6Wf20v3p4Hy5K7H97Tp
GOOGLE_DRIVE_TEMPLATES_FOLDER_ID=1fCKQJ01B2Vtu1oAfhFsTAPGgaGeOL0fY
GOOGLE_DRIVE_FOLDER_ID=

# ─── Cloudflare R2 (Alternative Storage) ──────────────────────────────────────
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret_key
R2_BUCKET=certflow-storage

# ─── App URLs ────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

# ─── Security ────────────────────────────────────────────────────────────────
SECRET_KEY=your-secret-key-for-jwt-signing-minimum-32-chars
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── Environment ─────────────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO
